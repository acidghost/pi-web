    "typescript": "7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.86.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@pierre/diffs": "1.5.1",
    "dompurify": "3.4.16",
    "lit": "3.3.3",
    "marked": "18.0.14",
    "missing.css": "1.3.0",
    "zod": "4.6.5"
  }
